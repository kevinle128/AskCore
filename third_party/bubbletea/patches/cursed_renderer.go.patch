+// replayInline constructs one repair generation under the renderer lock.
+func (s *cursedRenderer) replayInline(entries []string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.view.AltScreen {
+		return fmt.Errorf("inline replay is forbidden in alternate screen")
+	}
+	var output bytes.Buffer
+	if s.syncdUpdates {
+		output.WriteString(ansi.SetModeSynchronizedOutput)
+	}
+	output.WriteString("\x1b[2J\x1b[3J\x1b[H")
+	output.WriteString("\x1b[0m")
+	for _, entry := range entries {
+		output.WriteString(entry)
+		output.WriteString("\r\n")
+	}
+	writer := s.w
+	s.w = &output
+	reset(s)
+	s.cellbuf = uv.NewScreenBuffer(s.width, s.height)
+	s.awaitingSizedView = false
+	s.pendingErase = true
+	s.scr.Erase()
+	syncd := s.syncdUpdates
+	s.syncdUpdates = false
+	err := s.flushLocked(false)
+	s.syncdUpdates = syncd
+	s.w = writer
+	if err != nil {
+		return err
+	}
+	if s.syncdUpdates {
+		output.WriteString(ansi.ResetModeSynchronizedOutput)
+	}
+	if _, err := io.Copy(writer, &output); err != nil {
+		return fmt.Errorf("bubbletea: inline replay write: %w", err)
+	}
+	return nil
