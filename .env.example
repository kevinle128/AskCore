# Application settings
HOST=0.0.0.0
PORT=8080

# Allowed web origin for CORS (unset or empty = allow any origin)
CORS_ORIGIN=http://localhost:3001

# SQLite database file path (a plain path, not a file: URI)
DATABASE_URL=app.db

# gRPC settings (if using gRPC)
GRPC_PORT=50051

# Logging level
LOG_LEVEL=debug

# go-redis settings
REDIS_URL=redis://127.0.0.1:6379

# Asynq Redis settings
REDIS_ADDR=127.0.0.1:6379

# OpenTelemetry settings
OTEL_SERVICE_NAME=AskCore
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318